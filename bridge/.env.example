# Copy to bridge/.env and edit.

# --- Watch side -------------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
# Must match VIBE_BRIDGE_TOKEN in the firmware's include/secrets.h
WATCH_TOKEN=change-me-to-a-long-random-string

# --- Hermes side ------------------------------------------------------------
# Bridge runs in the same container as Hermes, so loopback is fine and
# Hermes' API never has to be exposed to the LAN.
HERMES_URL=http://127.0.0.1:8642
# Same value as API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=change-me
HERMES_MODEL=hermes-agent
# Max silence (s) on a run's event stream before falling back to polling
HERMES_TIMEOUT=900

# --- Approvals --------------------------------------------------------------
# How long the watch pop-up waits before failing closed (deny). Keep it below
# approvals.timeout in ~/.hermes/config.yaml (default 300).
APPROVAL_TTL_S=240
# Also say "Agent N needs approval: ..." through the watch speaker
APPROVAL_SPEAK=1

# --- Multiple Hermes profiles (optional) ------------------------------------
# Swipe left/right on the watch to switch. Each profile gets its own 6 agents,
# status ring, and token count. Leave unset for a single Hermes (above).
# HERMES_PROFILES=home=http://127.0.0.1:8642,coding=http://127.0.0.1:8643
# HERMES_API_KEY_HOME=...
# HERMES_API_KEY_CODING=...
# HERMES_COLOR_CODING=33C4E8

# --- Speech -----------------------------------------------------------------
# tiny.en / base.en / small.en  (small.en is noticeably better, ~2-3x slower on CPU)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=en
PIPER_VOICE=/opt/vibewatch-bridge/models/en_US-lessac-medium.onnx
TTS_GAIN=0.6
MAX_SPOKEN_CHARS=900

# --- Status ring ------------------------------------------------------------
# How often the watch's status ring/page is refreshed from Hermes
STATUS_INTERVAL_S=30
# Optional daily token budget; the ring shows what's left and resets at local
# midnight (set the container's timezone). 0 = no budget, ring stays full.
DAILY_TOKEN_BUDGET=0
# USAGE_FILE=/opt/vibewatch-bridge/usage.json

LOG_LEVEL=INFO
